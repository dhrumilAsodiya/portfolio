# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Required for the portfolio chatbot (LLM-powered).
# Get a free key at https://console.groq.com
# This is a SERVER-SIDE variable — do NOT prefix with VITE_.
# Add it to Vercel project settings → Environment Variables.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GROQ_MODEL: Optional model override for the chatbot.
# Defaults to openai/gpt-oss-20b if not set.
# Example: GROQ_MODEL="openai/gpt-oss-20b"
GROQ_MODEL="openai/gpt-oss-20b"

# ALLOWED_ORIGIN: Optional CORS restriction for /api/chat in production.
# Example: ALLOWED_ORIGIN="https://your-portfolio.vercel.app"
ALLOWED_ORIGIN=""

# VITE_WEB3FORMS_ACCESS_KEY: Public access key for Web3Forms contact form submissions.
# Get a free access key at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY="YOUR_WEB3FORMS_ACCESS_KEY"
